<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Privilege (Odoo 20 access rights structure) -->
    <record model="res.groups.privilege" id="res_groups_privilege_petty_cash">
        <field name="name">Petty Cash</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">30</field>
    </record>

    <!-- Security Groups -->
    <record id="group_petty_cash_custodian" model="res.groups">
        <field name="name">Custodian</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_petty_cash_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('group_petty_cash_custodian'))]"/>
    </record>

    <record id="group_petty_cash_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('group_petty_cash_approver'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
