<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_petty_cash_root"
              name="Petty Cash"
              sequence="45"
              web_icon="petty_cash_management,static/description/icon.png"
              groups="petty_cash_management.group_petty_cash_custodian,base.group_system"/>

    <!-- Funds Menu -->
    <menuitem id="menu_petty_cash_fund"
              name="Funds"
              parent="menu_petty_cash_root"
              action="action_petty_cash_fund"
              sequence="10"/>

    <!-- Expenses Menu -->
    <menuitem id="menu_petty_cash_voucher"
              name="Expenses"
              parent="menu_petty_cash_root"
              action="action_petty_cash_voucher"
              sequence="20"/>

    <!-- Top-ups Menu (Custodian and Manager) -->
    <menuitem id="menu_petty_cash_topup"
              name="Top-ups"
              parent="menu_petty_cash_root"
              action="action_petty_cash_topup"
              sequence="25"/>

    <!-- To Approve Menu (Manager Only) -->
    <menuitem id="menu_petty_cash_voucher_to_approve"
              name="To Approve"
              parent="menu_petty_cash_root"
              action="action_petty_cash_voucher_to_approve"
              sequence="30"
              groups="petty_cash_management.group_petty_cash_manager"/>

    <!-- Configuration Menu (Manager and Administrator) -->
    <menuitem id="menu_petty_cash_config"
              name="Configuration"
              parent="menu_petty_cash_root"
              sequence="100"
              groups="petty_cash_management.group_petty_cash_manager,base.group_system"/>

    <!-- Settings Menu (Administrator Only) -->
    <menuitem id="menu_petty_cash_settings"
              name="Settings"
              parent="menu_petty_cash_config"
              action="action_petty_cash_configuration"
              sequence="5"
              groups="base.group_system"/>

    <!-- Categories Menu (Manager Only) -->
    <menuitem id="menu_petty_cash_category"
              name="Categories"
              parent="menu_petty_cash_config"
              action="action_petty_cash_category"
              sequence="10"
              groups="petty_cash_management.group_petty_cash_manager"/>

    <!-- Top-up Sources Menu (Manager Only) -->
    <menuitem id="menu_petty_cash_topup_source"
              name="Top-up Sources"
              parent="menu_petty_cash_config"
              action="action_petty_cash_topup_source"
              sequence="20"
              groups="petty_cash_management.group_petty_cash_manager"/>
</odoo>
