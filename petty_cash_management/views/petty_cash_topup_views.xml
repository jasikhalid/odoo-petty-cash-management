<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Petty Cash Top-up Form View -->
    <record id="view_petty_cash_topup_form" model="ir.ui.view">
        <field name="name">petty.cash.topup.form</field>
        <field name="model">petty.cash.topup</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Top-up">
                <header>
                    <button name="action_post"
                            string="Post"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="petty_cash_management.group_petty_cash_manager"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'draft'"
                            groups="petty_cash_management.group_petty_cash_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_journal_entry"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-bars"
                                invisible="not move_id"
                                groups="account.group_account_readonly">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal Entry</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Reference"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Fund &amp; Source">
                            <field name="fund_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="source_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group string="Amount &amp; Company">
                            <field name="amount" widget="monetary" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="posted_by_id" invisible="state != 'posted'"/>
                            <field name="posted_date" invisible="state != 'posted'"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" placeholder="Additional details regarding the replenishment..." readonly="state != 'draft'" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Petty Cash Top-up List View -->
    <record id="view_petty_cash_topup_list" model="ir.ui.view">
        <field name="name">petty.cash.topup.list</field>
        <field name="model">petty.cash.topup</field>
        <field name="arch" type="xml">
            <list string="Petty Cash Top-ups">
                <field name="name"/>
                <field name="fund_id"/>
                <field name="source_id"/>
                <field name="date"/>
                <field name="amount" sum="Total Amount"/>
                <field name="currency_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Petty Cash Top-up Search View -->
    <record id="view_petty_cash_topup_search" model="ir.ui.view">
        <field name="name">petty.cash.topup.search</field>
        <field name="model">petty.cash.topup</field>
        <field name="arch" type="xml">
            <search string="Search Top-ups">
                <field name="name"/>
                <field name="fund_id"/>
                <field name="source_id"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter name="group_fund" string="Fund" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_source" string="Source" context="{'group_by': 'source_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:month'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Petty Cash Top-up Action -->
    <record id="action_petty_cash_topup" model="ir.actions.act_window">
        <field name="name">Top-ups</field>
        <field name="res_model">petty.cash.topup</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_petty_cash_topup_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Replenish a Petty Cash Fund
            </p>
            <p>
                Record top-ups into petty cash funds from authorized funding sources.
            </p>
        </field>
    </record>
</odoo>
