<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Petty Cash Top-up Source Form View -->
    <record id="view_petty_cash_topup_source_form" model="ir.ui.view">
        <field name="name">petty.cash.topup.source.form</field>
        <field name="model">petty.cash.topup.source</field>
        <field name="arch" type="xml">
            <form string="Top-up Source">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Source Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Main Bank Account, Treasury Cash"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Petty Cash Top-up Source List View -->
    <record id="view_petty_cash_topup_source_list" model="ir.ui.view">
        <field name="name">petty.cash.topup.source.list</field>
        <field name="model">petty.cash.topup.source</field>
        <field name="arch" type="xml">
            <list string="Top-up Sources">
                <field name="name"/>
                <field name="account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Petty Cash Top-up Source Search View -->
    <record id="view_petty_cash_topup_source_search" model="ir.ui.view">
        <field name="name">petty.cash.topup.source.search</field>
        <field name="model">petty.cash.topup.source</field>
        <field name="arch" type="xml">
            <search string="Search Top-up Sources">
                <field name="name"/>
                <field name="account_id"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Petty Cash Top-up Source Action -->
    <record id="action_petty_cash_topup_source" model="ir.actions.act_window">
        <field name="name">Top-up Sources</field>
        <field name="res_model">petty.cash.topup.source</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_petty_cash_topup_source_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first petty cash top-up source
            </p>
            <p>
                Configure funding sources such as bank accounts or treasury cash to replenish petty cash funds.
            </p>
        </field>
    </record>
</odoo>
