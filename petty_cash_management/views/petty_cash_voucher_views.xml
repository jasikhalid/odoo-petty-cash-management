<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Voucher List View -->
    <record id="view_petty_cash_voucher_list" model="ir.ui.view">
        <field name="name">petty.cash.voucher.list</field>
        <field name="model">petty.cash.voucher</field>
        <field name="arch" type="xml">
            <list string="Petty Cash Vouchers" sample="1">
                <field name="name"/>
                <field name="date"/>
                <field name="fund_id"/>
                <field name="category_id"/>
                <field name="description"/>
                <field name="payee_type"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'posted'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Voucher Form View -->
    <record id="view_petty_cash_voucher_form" model="ir.ui.view">
        <field name="name">petty.cash.voucher.form</field>
        <field name="model">petty.cash.voucher</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Voucher">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="petty_cash_management.group_petty_cash_approver"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-secondary"
                            invisible="state != 'submitted'"
                            groups="petty_cash_management.group_petty_cash_approver"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-secondary"
                            invisible="state != 'rejected'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"
                            invisible="state in ('cancelled', 'posted')"/>
                    <button name="action_cancel" string="Reverse Entry" type="object" class="btn-secondary"
                            invisible="state != 'posted'"
                            groups="petty_cash_management.group_petty_cash_manager"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,posted,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attachments" type="object" class="oe_stat_button" icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Receipts"/>
                        </button>
                        <button name="action_view_journal_entry" type="object" class="oe_stat_button" icon="fa-book"
                                invisible="not move_id"
                                groups="account.group_account_readonly">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal Entry</span>
                            </div>
                        </button>
                        <button name="action_view_reversal_entry" type="object" class="oe_stat_button" icon="fa-undo"
                                invisible="not reversal_move_id"
                                groups="account.group_account_readonly">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Reversal Entry</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <span class="o_form_label" invisible="state != 'draft'">New Voucher</span>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="fund_id" readonly="state != 'draft'"/>
                            <field name="category_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="state != 'draft'"/>
                            <field name="payee_type" readonly="state != 'draft'"/>
                            <field name="partner_id" invisible="payee_type != 'partner'" required="payee_type == 'partner'" readonly="state != 'draft'"/>
                            <field name="employee_id" invisible="payee_type != 'employee'" required="payee_type == 'employee'" readonly="state != 'draft'"/>
                            <field name="payee_name" invisible="payee_type != 'other'" required="payee_type == 'other'" readonly="state != 'draft'"/>
                            <field name="analytic_account_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Business purpose of this expense..." readonly="state != 'draft'"/>
                    </group>

                    <notebook>
                        <page string="Audit Info" name="audit_info">
                            <group>
                                <group string="Workflow History">
                                    <field name="submitted_by_id"/>
                                    <field name="submitted_date"/>
                                    <field name="approved_by_id"/>
                                    <field name="approved_date"/>
                                </group>
                                <group string="Accounting Links">
                                    <field name="move_id"/>
                                    <field name="reversal_move_id"/>
                                </group>
                            </group>
                            <group string="Rejection / Cancellation Details" invisible="not rejection_reason and not cancel_reason">
                                <field name="rejection_reason" invisible="not rejection_reason"/>
                                <field name="cancel_reason" invisible="not cancel_reason"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Voucher Search View -->
    <record id="view_petty_cash_voucher_search" model="ir.ui.view">
        <field name="name">petty.cash.voucher.search</field>
        <field name="model">petty.cash.voucher</field>
        <field name="arch" type="xml">
            <search string="Search Petty Cash Vouchers">
                <field name="name"/>
                <field name="description"/>
                <field name="payee_name"/>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <field name="fund_id"/>
                <field name="category_id"/>
                <separator/>
                <filter string="My Vouchers" name="my_vouchers" domain="[('create_uid', '=', uid)]"/>
                <filter string="To Approve" name="to_approve" domain="[('state', '=', 'submitted')]"/>
                <separator/>
                <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="state_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Posted" name="state_posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Cancelled" name="state_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter string="Fund" name="group_by_fund" context="{'group_by': 'fund_id'}"/>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Payee Type" name="group_by_payee_type" context="{'group_by': 'payee_type'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_petty_cash_voucher" model="ir.actions.act_window">
        <field name="name">Vouchers</field>
        <field name="res_model">petty.cash.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_petty_cash_voucher_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a new petty cash expense voucher.
            </p>
        </field>
    </record>

    <record id="action_petty_cash_voucher_to_approve" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">petty.cash.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'submitted')]</field>
        <field name="search_view_id" ref="view_petty_cash_voucher_search"/>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>
</odoo>
